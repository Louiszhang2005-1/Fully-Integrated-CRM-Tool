# ===========================================
# La Centrale Agricole CRM — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your real values
# NEVER commit .env.local to git!
#
# cp .env.example .env.local

# --- AI Message Generation (Google Gemini) ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email Sending (Resend) ---
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# --- Contact Enrichment (Apollo.io) ---
# Get your key at: https://app.apollo.io/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here
